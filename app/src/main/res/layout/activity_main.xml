<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#F8F9FA">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONTROL DE PARQUEADERO"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etPlaca"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:hint="PLACA (EJ: ABC123)"
        android:textSize="36sp"
        android:textStyle="bold"
        android:gravity="center"
        android:inputType="textCapCharacters"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnBuscar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:text="1. CONSULTAR ESTADO"
        android:textSize="20sp"
        android:textStyle="bold"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <!-- NUEVOS BOTONES DE NAVEGACIÓN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnVerLista"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="VER LISTA\nPARQUEADOS"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnMensualidades"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="GESTIONAR\nMENSUALIDAD"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#9C27B0"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tarjetaSemaforo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#E0E0E0"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="16dp"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvMensajeSemaforo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ESPERANDO PLACA..."
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:textAlignment="center" />
    </LinearLayout>

    <Button
        android:id="@+id/btnIngresoDia"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:text="REGISTRAR PASE DE DÍA (24H)"
        android:textSize="22sp"
        android:textStyle="bold"
        android:backgroundTint="#607D8B"
        android:textColor="#FFFFFF" />
</LinearLayout>